APP_NAME=Drone MatrX API
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://dronematrx:dronematrx@localhost:5433/dronematrx

JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

TELEMETRY_SIMULATOR_ENABLED=true
TELEMETRY_PROVIDER=simulator
TELEMETRY_TICK_SECONDS=1.0

# Sprint 4 -- NATS JetStream (see docker-compose service "nats")
NATS_ENABLED=true
NATS_URL=nats://localhost:4222
NATS_STREAM=DRONES
NATS_MONITOR_URL=http://localhost:8222
ORCA_ENABLED=true
